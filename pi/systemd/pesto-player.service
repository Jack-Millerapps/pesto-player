[Unit]
Description=Pesto Player (framebuffer launcher)
After=ft6336-touch.service
Wants=ft6336-touch.service pesto-uploader.service

[Service]
User=pesto
SupplementaryGroups=video input audio render
ExecStartPre=+-/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon1/bind'
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 /home/pesto/pesto-player/pi/pesto_fb_launch.py
# on-failure (not always): Settings > Exit and the power-button shutdown end the
# app with status 0 and must NOT be restarted. Settings > Restart exits with 3.
Restart=on-failure
RestartForceExitStatus=3
RestartSec=3

[Install]
WantedBy=multi-user.target
